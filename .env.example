# Telegram API — get from https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Your phone number with country code, e.g. +79001234567
TELEGRAM_PHONE=

# Public channel to analyze (with @)
TELEGRAM_CHANNEL=@yourchannel

# Bot token from @BotFather
BOT_TOKEN=

# Your personal Telegram chat ID
# To get it: message @userinfobot in Telegram
YOUR_CHAT_ID=

# Anthropic API key
ANTHROPIC_API_KEY=

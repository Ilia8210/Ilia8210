# Telegram API — get from https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Your phone number (needed only for auth.py)
TELEGRAM_PHONE=

# Telegram session string — generated by auth.py
TELEGRAM_SESSION=

# Public channel to analyze (with @)
TELEGRAM_CHANNEL=@yourchannel

# Bot token from @BotFather
BOT_TOKEN=

# Your personal Telegram chat ID
# To get it: message @userinfobot in Telegram
YOUR_CHAT_ID=

# Anthropic API key — get at https://console.anthropic.com
ANTHROPIC_API_KEY=
